# Copia este archivo como .env y completa los valores.

PORT=3000

# Acceso a la página (déjalo vacío solo para pruebas locales)
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave

# Datos del recibo
ORG_NOMBRE=Comunidad Católica Shalom
ZONA_HORARIA=America/Panama
MONEDA=USD

# Envío de correo: "graph" (Outlook / Microsoft 365) o "ninguno" (modo prueba)
EMAIL_PROVEEDOR=ninguno
EMAIL_REMITENTE=Juventudpanama@comshalom.com

# Credenciales de la app registrada en Microsoft Entra (ver README)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Ruta de la base de datos (opcional)
# DB_PATH=./data/pagos.db
